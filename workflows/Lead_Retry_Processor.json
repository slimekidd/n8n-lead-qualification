      "name": "Retry Lead Processing",
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads\nSET\n    status = 'failed',\n    error_message = COALESCE($2::text, 'Retry execution failed'),\n    next_retry_at = CASE\n        WHEN COALESCE(retry_count, 0) < 3\n         AND (\n             $2 ILIKE '%503%'\n             OR $2 ILIKE '%429%'\n             OR $2 ILIKE '%timeout%'\n             OR $2 ILIKE '%temporarily unavailable%'\n         )\n        THEN NOW() + INTERVAL '10 minutes'\n        ELSE NULL\n    END\nWHERE lead_id = $1\n  AND status = 'processing'\n  AND parent_execution_id = $3\nRETURNING\n    lead_id,\n    status,\n    retry_count,\n    next_retry_at,\n    error_message;",
        "options": {
          "queryReplacement": "={{ [\n  $('Process Retry Queue').item.json.lead_id,\n  typeof $json.error === 'string'\n    ? $json.error\n    : ($json.error?.message ?? $json.message ?? 'Retry execution failed'),\n  String($execution.id)\n] }}"
        }
      },
