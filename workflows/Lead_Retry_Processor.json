    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    lead_id,\n    client_name,\n    company,\n    budget,\n    request,\n    status,\n    error_message,\n    execution_id,\n    retry_count,\n    next_retry_at,\n    sheets_saved,\n    telegram_sent\nFROM leads\nWHERE status = 'failed'\n  AND COALESCE(retry_count, 0) < 3\n  AND next_retry_at IS NOT NULL\n  AND next_retry_at <= NOW()\nORDER BY created_at ASC\nLIMIT 20;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -464,
        16
      ],
